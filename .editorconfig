root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{mjs,js,json}]
indent_size = 2
max_line_length = 100

[*.md]
# Trailing whitespace is significant for Markdown hard line breaks.
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab
